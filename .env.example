# Catalogue provider: "oneflex" (default) or "tmdb"
CATALOGUE_PROVIDER=oneflex
NEXT_PUBLIC_CATALOGUE_PROVIDER=oneflex

# Movie catalogue (TMDB-compatible — same library as cinejoy.to)
CATALOGUE_API_URL=https://db.1flex.org
CATALOGUE_API_ORIGIN=https://www.1flex.org

# Playback embed (Videasy — works inside Wave; cinejoy.to blocks iframe embeds)
ONEFLEX_EMBED_SERVER=MAIN_2

# Watch provider region for Browse by Provider (ISO 3166-1)
WATCH_REGION=US

# Optional TMDB fallback provider
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
