# Catalogue provider: "oneflex" (default) or "tmdb"
CATALOGUE_PROVIDER=oneflex
NEXT_PUBLIC_CATALOGUE_PROVIDER=oneflex

# 1Flex catalogue API (same database as 1flex.org)
ONEFLEX_API_URL=https://db.1flex.org
ONEFLEX_ORIGIN=https://www.1flex.org
# Default embed server: MAIN_4 (Vidlink), MAIN_2 (Videasy), MAIN_3 (Vidfast), etc.
ONEFLEX_EMBED_SERVER=MAIN_4
# Or override with a custom template: https://example.com/movie/{id}
# ONEFLEX_EMBED_URL=

# TMDB API (optional fallback provider)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
