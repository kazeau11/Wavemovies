# Catalogue provider: "oneflex" (Cinejoy TMDB catalogue) or "tmdb"
CATALOGUE_PROVIDER=oneflex
NEXT_PUBLIC_CATALOGUE_PROVIDER=oneflex

# Cinejoy — movie catalogue + playback (same library as cinejoy.to)
CINEJOY_ORIGIN=https://cinejoy.to
# Optional: TMDB-compatible catalogue upstream (same data cinejoy uses)
# CINEJOY_CATALOGUE_UPSTREAM=
# Or use official TMDB API:
TMDB_API_KEY=your_tmdb_api_key_here

# Playback embed (default: Cinejoy player)
ONEFLEX_EMBED_SERVER=CINEJOY

# Watch provider region for Browse by Provider (ISO 3166-1)
WATCH_REGION=US

# TMDB images (used for posters/backdrops)
TMDB_BASE_URL=https://api.themoviedb.org/3
